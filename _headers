# Cloudflare Pages response headers.
#
# Rules are matched most specific first. Hashed filenames are not in use here,
# so HTML stays revalidated on every request and only the fingerprint-stable
# assets get a long cache.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# HTML changes whenever the content does, so it is always revalidated
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Fonts and images are replaced by filename rather than edited in place
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS are edited in place, so a day with revalidation rather than a year
/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate
